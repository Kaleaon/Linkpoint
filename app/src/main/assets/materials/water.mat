material {
    name : Water,
    shadingModel : lit,
    
    parameters : [
        {
            type : sampler2D,
            name : normalMap
        },
        {
            type : float3,
            name : waterColor,
            default : [0.0, 0.3, 0.5]
        },
        {
            type : float,
            name : roughness,
            default : 0.1
        },
        {
            type : float,
            name : time,
            default : 0.0
        },
        {
            type : float,
            name : waveScale,
            default : 1.0
        }
    ],
    
    requires : [
        uv0,
        tangents
    ],
    
    blending : transparent,
    transparency : twoPassesOneSide,
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Animate water surface
        vec3 pos = material.worldPosition.xyz;
        float wave = sin(pos.x * materialParams.waveScale + materialParams.time) * 
                     cos(pos.y * materialParams.waveScale + materialParams.time);
        material.worldPosition.z += wave * 0.1;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        
        vec2 uv = getUV0();
        
        // Animated water normals
        vec2 uv1 = uv + vec2(materialParams.time * 0.01, 0.0);
        vec2 uv2 = uv + vec2(0.0, materialParams.time * 0.01);
        vec3 normal1 = texture(materialParams_normalMap, uv1).rgb * 2.0 - 1.0;
        vec3 normal2 = texture(materialParams_normalMap, uv2).rgb * 2.0 - 1.0;
        vec3 normal = normalize(normal1 + normal2);
        
        material.baseColor = vec4(materialParams.waterColor, 0.7);
        material.normal = normal;
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
    }
}
