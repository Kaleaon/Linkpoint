      { "selector": ".lcars-panel", "styles": { "display": "grid", "grid-template-columns": "220px 1fr", "gap": 10 } },
      { "selector": ".btn", "styles": { "border-radius": 0, "border-top-left-radius": 22, "border-bottom-left-radius": 22, "text-transform": "uppercase", "letter-spacing": "1.5px", "font-weight": 700 } },
      { "selector": ".chip", "styles": { "border-radius": 0, "text-transform": "uppercase", "letter-spacing": "1px", "font-weight": 700 } }
