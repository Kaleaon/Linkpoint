[Startup]
    ServiceConnector = "OpenSim.Server.Handlers.dll:ServiceConnector"

[Network]
    port = {{ ROBUST_PORT | default(8002) }}

[DatabaseService]
    StorageProvider = "OpenSim.Data.MySQL.dll"
    ConnectionString = "Data Source={{ MYSQL_HOST | default('db') }};Database={{ MYSQL_DATABASE | default('opensim') }};User ID={{ MYSQL_USER | default('opensim') }};Password={{ MYSQL_PASSWORD | default('opensimpass') }};Port={{ MYSQL_PORT | default(3306) }};"

[ServiceList]
    UserAccountServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:UserAccountServiceConnector"
    AuthenticationServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:AuthenticationServiceConnector"
    GridServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:GridServiceConnector"
    AssetServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:AssetServiceConnector"
    InventoryServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:XInventoryInConnector"
    PresenceServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:PresenceServerConnector"
    FriendsServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:FriendsServerConnector"
    GridUserServiceConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:GridUserServerConnector"
    LLLoginServiceInConnector = "{{ ROBUST_PORT | default(8002) }}/OpenSim.Server.Handlers.dll:LLLoginServiceInConnector"

[UserAccountService]
    LocalServiceModule = "OpenSim.Services.UserAccountService.dll:UserAccountService"

[AuthenticationService]
    LocalServiceModule = "OpenSim.Services.AuthenticationService.dll:PasswordAuthenticationService"

[GridService]
    LocalServiceModule = "OpenSim.Services.GridService.dll:GridService"
    Realm = "regions"
    AllowDuplicateNames = false

[AssetService]
    LocalServiceModule = "OpenSim.Services.AssetService.dll:AssetService"

[InventoryService]
    LocalServiceModule = "OpenSim.Services.InventoryService.dll:XInventoryService"

[PresenceService]
    LocalServiceModule = "OpenSim.Services.PresenceService.dll:PresenceService"

[FriendsService]
    LocalServiceModule = "OpenSim.Services.FriendsService.dll:FriendsService"

[GridUserService]
    LocalServiceModule = "OpenSim.Services.UserAccountService.dll:GridUserService"

[LoginService]
    LocalServiceModule = "OpenSim.Services.LLLoginService.dll:LLLoginService"
    WelcomeMessage = "{{ WELCOME_MESSAGE | default('Welcome to OpenSim Grid!') }}"
    SRV_HomeURI = "{{ PUBLIC_URI | default('https://localhost') }}"
    SRV_InventoryServerURI = "{{ PUBLIC_URI | default('https://localhost') }}"
    SRV_AssetServerURI = "{{ PUBLIC_URI | default('https://localhost') }}"
