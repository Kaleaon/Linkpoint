material {
    name : PrimPBR,
    shadingModel : lit,
    
    parameters : [
        {
            type : sampler2D,
            name : baseColorMap
        },
        {
            type : sampler2D,
            name : normalMap
        },
        {
            type : sampler2D,
            name : metallicRoughnessMap
        },
        {
            type : sampler2D,
            name : emissiveMap
        },
        {
            type : sampler2D,
            name : occlusionMap
        },
        {
            type : float3,
            name : baseColorFactor,
            default : [1.0, 1.0, 1.0]
        },
        {
            type : float,
            name : metallicFactor,
            default : 1.0
        },
        {
            type : float,
            name : roughnessFactor,
            default : 1.0
        },
        {
            type : float3,
            name : emissiveFactor,
            default : [0.0, 0.0, 0.0]
        }
    ],
    
    requires : [
        uv0,
        tangents
    ],
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Pass through for PBR
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        
        vec2 uv = getUV0();
        
        // Sample all PBR textures
        vec4 baseColor = texture(materialParams_baseColorMap, uv);
        vec3 normal = texture(materialParams_normalMap, uv).rgb * 2.0 - 1.0;
        vec4 metallicRoughness = texture(materialParams_metallicRoughnessMap, uv);
        vec3 emissive = texture(materialParams_emissiveMap, uv).rgb;
        float occlusion = texture(materialParams_occlusionMap, uv).r;
        
        // Apply factors
        material.baseColor = vec4(baseColor.rgb * materialParams.baseColorFactor, baseColor.a);
        material.normal = normal;
        material.metallic = metallicRoughness.b * materialParams.metallicFactor;
        material.roughness = metallicRoughness.g * materialParams.roughnessFactor;
        material.emissive = vec4(emissive * materialParams.emissiveFactor, 0.0);
        material.ambientOcclusion = occlusion;
    }
}
