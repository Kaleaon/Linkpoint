<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="com.linkpoint.LinkpointApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Linkpoint">

        <activity
            android:name="com.linkpoint.ui.login.CleanLoginActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.linkpoint.ui.modern.ModernWorldActivity"
            android:exported="false"
            android:label="@string/modern_world_activity_label" />

        <service
            android:name="com.linkpoint.GridConnectionService"
            android:exported="false" />

        <service
            android:name="com.linkpoint.StreamingMediaService"
            android:exported="false" />

    </application>

</manifest>
