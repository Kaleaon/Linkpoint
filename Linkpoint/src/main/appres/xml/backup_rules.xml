<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Linkpoint app.
    Excludes sensitive data from cloud backups.
-->
<full-backup-content>
    <!-- Exclude sensitive preferences (credentials, tokens) -->
    <exclude domain="sharedpref" path="." />
    
    <!-- Exclude cache files -->
    <exclude domain="cache" path="." />
    
    <!-- Exclude database files that may contain sensitive data -->
    <exclude domain="database" path="." />
    
    <!-- Exclude external files -->
    <exclude domain="external" path="." />
</full-backup-content>
