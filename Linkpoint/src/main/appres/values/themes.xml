<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Linkpoint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lumiya_primary</item>
        <item name="colorPrimaryContainer">@color/lumiya_primary_dark</item>
        <item name="colorSecondary">@color/lumiya_secondary</item>
    </style>

    <style name="Theme.Linkpoint.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lumiya_primary</item>
        <item name="colorSecondary">@color/lumiya_secondary</item>
    </style>

    <style name="Theme.Linkpoint.Pink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#FFE91E63</item>
        <item name="colorPrimaryContainer">#FFD81B60</item>
        <item name="colorSecondary">#FFF06292</item>
    </style>

    <style name="Theme.Linkpoint.NoActionBar" parent="Theme.Linkpoint">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Application theme aliases referenced from Kotlin code -->
    <style name="Theme_LinkpointCompat" parent="Theme.Linkpoint" />
    <style name="Theme_LinkpointCompat_Light" parent="Theme.Linkpoint.Light" />
    <style name="Theme_LinkpointCompat_Pink" parent="Theme.Linkpoint.Pink" />
    <style name="Theme_LinkpointCompat_NoActionBar" parent="Theme.Linkpoint.NoActionBar" />

</resources>
