<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- CircleImageView style for avatar/profile images - based on Material Design patterns -->
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.Linkpoint" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <style name="Theme.Linkpoint.NoActionBar" parent="Theme.Linkpoint">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Linkpoint.Fullscreen" parent="Theme.Linkpoint.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

</resources>
