<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 3D Render View -->
        <FrameLayout
            android:id="@+id/renderContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- HUD Objects Overlay (rendered on top of 3D world) -->
        <com.linkpoint.hud.HUDOverlayView
            android:id="@+id/hudOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- UI Overlay -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Bar -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@color/overlay_dark">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_menu"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/textRegionName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Region Name"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textAvatarName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avatar Name"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Debug Report Floating Action Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDebugFloater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_bug_report"
                android:contentDescription="@string/capture_debug_report"
                android:visibility="gone"
                app:fabSize="mini"
                app:backgroundTint="@color/design_default_color_error" />

            <!-- Movement Joystick (Left side) -->
            <com.linkpoint.ui.world.JoystickView
                android:id="@+id/joystickMove"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="80dp" />

            <!-- Camera/Rotation Joystick (Right side) -->
            <com.linkpoint.ui.world.JoystickView
                android:id="@+id/joystickCamera"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="80dp" />

            <!-- Movement Control Buttons (Right side, above camera joystick) -->
            <LinearLayout
                android:id="@+id/movementButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_above="@id/joystickCamera"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:gravity="end">

                <ImageButton
                    android:id="@+id/btnFly"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_fly"
                    android:background="@drawable/circle_button"
                    android:contentDescription="@string/fly" />

                <ImageButton
                    android:id="@+id/btnRun"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_run"
                    android:background="@drawable/circle_button"
                    android:contentDescription="@string/run" />

                <ImageButton
                    android:id="@+id/btnJump"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_jump"
                    android:background="@drawable/circle_button"
                    android:contentDescription="@string/jump" />

                <ImageButton
                    android:id="@+id/btnSit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_sit"
                    android:background="@drawable/circle_button"
                    android:contentDescription="@string/sit" />

            </LinearLayout>

            <!-- Vertical Action Buttons (Left side, above movement joystick) -->
            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_above="@id/joystickMove"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:gravity="start">

                <ImageButton
                    android:id="@+id/btnGestures"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_gesture"
                    android:background="@drawable/circle_button"
                    android:contentDescription="@string/gestures" />

                <ImageButton
                    android:id="@+id/btnFriends"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_friends"
                    android:background="@drawable/circle_button"
                    android:contentDescription="@string/friends" />

                <ImageButton
                    android:id="@+id/btnNearby"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_nearby"
                    android:background="@drawable/circle_button"
                    android:contentDescription="@string/nearby" />

            </LinearLayout>

            <!-- Bottom Quick Actions -->
            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center"
                android:background="@color/overlay_dark">

                <ImageButton
                    android:id="@+id/btnChat"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_chat"
                    android:background="@drawable/circle_button"
                    android:contentDescription="Chat" />

                <ImageButton
                    android:id="@+id/btnMinimap"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_minimap"
                    android:background="@drawable/circle_button"
                    android:contentDescription="Minimap" />

                <ImageButton
                    android:id="@+id/btnInventory"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_inventory"
                    android:background="@drawable/circle_button"
                    android:contentDescription="Inventory" />

                <ImageButton
                    android:id="@+id/btnXR"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_xr"
                    android:background="@drawable/circle_button"
                    android:contentDescription="XR Mode" />

            </LinearLayout>

        </RelativeLayout>

    </FrameLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
