<?xml version="1.0" encoding="utf-8"?>
<!--
    Main Activity - Tablet Layout with Navigation Rail
    Optimized for larger screens with:
    - Navigation rail on the side
    - More horizontal space usage
    - Better multitasking support
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        
        <!-- Navigation Rail (Left Side) -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/navigationRail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:menu="@menu/navigation_rail_menu"
            app:labelVisibilityMode="labeled"
            app:headerLayout="@layout/navigation_rail_header"
            style="@style/Widget.Lumiya.NavigationRail">
            
            <!-- FAB in Navigation Rail Header -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/railFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Create"
                app:srcCompat="@drawable/ic_add_24"
                style="@style/Widget.Lumiya.FloatingActionButton" />
        </com.google.android.material.navigationrail.NavigationRailView>
        
        <!-- Main Content Area -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph_main" />
    </LinearLayout>
    
</androidx.coordinatorlayout.widget.CoordinatorLayout>
