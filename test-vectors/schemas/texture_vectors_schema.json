{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Texture Decoder Test Vectors Schema",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "j2k_vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "hex_bytes": { "type": "string" },
          "expected": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "channels": { "type": "integer" },
              "buffer_length": { "type": "integer" },
              "sha256": { "type": "string" }
            },
            "required": ["status", "width", "height"]
          }
        },
        "required": ["name", "hex_bytes", "expected"]
      }
    }
  },
  "required": ["version", "j2k_vectors"]
}
