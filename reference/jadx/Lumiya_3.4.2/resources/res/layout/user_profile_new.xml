<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:lumiya="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.astuetz.PagerSlidingTabStrip
        android:id="@+id/user_profile_tabs"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        lumiya:pstsIndicatorColor="?attr/controlLabelColor"
        lumiya:pstsShouldExpand="true"
        lumiya:pstsTabTextColor="?attr/controlLabelColor"/>
    <android.support.v4.view.ViewPager
        android:id="@+id/user_profile_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
