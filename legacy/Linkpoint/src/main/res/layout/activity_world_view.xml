<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.linkpoint.ui.world.WorldViewportHost
            android:id="@+id/worldViewportHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/worldOverlayCompose"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Legacy controls kept for wiring/state continuity; now hidden under Compose overlay. -->
        <RelativeLayout
            android:id="@+id/legacyControls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageButton android:id="@+id/btnMenu" android:layout_width="1dp" android:layout_height="1dp" />
                <TextView android:id="@+id/textRegionName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/textAvatarName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <com.linkpoint.ui.world.JoystickView
                android:id="@+id/joystickMove"
                android:layout_width="150dp"
                android:layout_height="150dp" />

            <com.linkpoint.ui.world.JoystickView
                android:id="@+id/joystickCamera"
                android:layout_width="120dp"
                android:layout_height="120dp" />

            <LinearLayout
                android:id="@+id/movementButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageButton android:id="@+id/btnFly" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnRun" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnJump" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnSit" android:layout_width="1dp" android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageButton android:id="@+id/btnGestures" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnFriends" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnNearby" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnCameraMode" android:layout_width="1dp" android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageButton android:id="@+id/btnChat" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnMinimap" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnInventory" android:layout_width="1dp" android:layout_height="1dp" />
                <ImageButton android:id="@+id/btnXR" android:layout_width="1dp" android:layout_height="1dp" />
            </LinearLayout>
        </RelativeLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnDebugFloater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_bug_report"
            android:contentDescription="@string/capture_debug_report"
            android:visibility="gone"
            app:fabSize="mini"
            app:backgroundTint="@color/design_default_color_error" />

    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
