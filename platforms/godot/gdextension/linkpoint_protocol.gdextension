[configuration]
entry_symbol = "linkpoint_protocol_library_init"
compatibility_minimum = "4.0"

[libraries]
linux.x86_64 = "res://bin/liblinkpoint_protocol.linux.template_release.x86_64.so"
windows.x86_64 = "res://bin/liblinkpoint_protocol.windows.template_release.x86_64.dll"
macos.framework = "res://bin/liblinkpoint_protocol.macos.template_release.framework"
linux.debug.x86_64 = "res://bin/liblinkpoint_protocol.linux.template_debug.x86_64.so"
windows.debug.x86_64 = "res://bin/liblinkpoint_protocol.windows.template_debug.x86_64.dll"
macos.debug.framework = "res://bin/liblinkpoint_protocol.macos.template_debug.framework"
