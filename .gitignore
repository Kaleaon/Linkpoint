# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
# Exception: Include Filament build configuration
!Filament/build/

# Gradle files
.gradle/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.iws
*.ipr

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Version control
vcs.xml

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Prevent junk file accumulation
*.zip
*.tar.gz
*.jar
# Exception: Keep gradle wrapper jar for builds
!**/gradle-wrapper.jar
*.idsig
*.args
classes.dex.xml
debug.keystore
# Ignore decompiled index.html but not PWA index.html
/app/src/main/**/index.html
/sources/**/index.html
/tools/**/index.html

# Decompiled and temporary directories
sources/
voice_plugin_decompiled/
simple_build/
lumiya_build/
template_extracted/
manual_apk/
temp_java/
tools/

# Test files and build scripts (keep only gradlew)
*test*.java
*test*.sh
comprehensive_*.java
network_*.java
*.sh
*.py
*.bat
!gradlew
!gradlew.bat
# Allow PWA-demo scripts
!PWA-demo/*.sh
!scripts/*.sh

# Build artifacts and backups
*.backup
dynamic_gradle.properties
gradle-universal-config.properties

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment files
*.env
*.env.*

# Signing files - NEVER commit these!
*.keystore
*.jks
keystore.properties
signing.properties
release.keystore
debug.keystore

# File Inventory System - Generated Files
file_inventory/
copilot_review_files/

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Android SDK files (should not be committed)
android-sdk/
test_xml_format.kt
test_xml_simple.sh

# Decompiled Lumiya reference code (keep only README)
docs/lumiya_reference/lumiyaviewer/

# Decompiled Lumiya sources (reference only)
lumiya_decompiled/
