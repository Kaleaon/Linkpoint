# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
# Exception: Include Filament build configuration
!Filament/build/

# Gradle files
.gradle/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Kotlin compiler cache
.kotlin/

# IntelliJ
*.iml
.idea/
*.iws
*.ipr

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Version control
vcs.xml

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Prevent junk file accumulation
*.zip
*.tar.gz
*.jar
# Exception: Keep gradle wrapper jar for builds
!**/gradle-wrapper.jar
*.idsig
*.args
classes.dex.xml
debug.keystore
# Ignore decompiled index.html but not PWA index.html
/app/src/main/**/index.html
/sources/**/index.html
/tools/**/index.html

# Decompiled and temporary directories
sources/
voice_plugin_decompiled/
simple_build/
lumiya_build/
template_extracted/
manual_apk/
temp_java/
tools/

# Test files and build scripts (keep only gradlew)
*test*.java
*test*.sh
comprehensive_*.java
network_*.java
*.sh
*.py
*.bat
!gradlew
!gradlew.bat
# Allow PWA-demo scripts
!PWA-demo/*.sh
!scripts/*.sh
!scripts/*.py

# Build artifacts and backups
*.backup
dynamic_gradle.properties
gradle-universal-config.properties

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment files
*.env
*.env.*

# Signing files - NEVER commit these!
*.keystore
*.jks
keystore.properties
signing.properties
release.keystore
debug.keystore

# File Inventory System - Generated Files
file_inventory/
copilot_review_files/

# Native shared libraries
*.so
*.dylib
*.dll

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Android SDK files (should not be committed)
android-sdk/
test_xml_format.kt
test_xml_simple.sh

# Decompiled Lumiya reference code (keep only README)
docs/lumiya_reference/lumiyaviewer/

# Decompiled Lumiya sources (reference only)
lumiya_decompiled/

# Protocol conformance tooling and schemas (LP-P0-001 / LP-P0-002 / LP-P0-003).
# These un-ignore rules counteract the repo-wide tools/, *.sh, and *.py
# blocks above so the schemas and protocol_gen CLI can live in version control.
!tools/
!schemas/
!schemas/**
!schemas/protocol/**
!tools/protocol_gen/
!tools/protocol_gen/**
!tools/protocol_gen/*.py
!tools/protocol_gen/**/*.py
!tools/protocol_gen/**/*.json
tools/protocol_gen/**/__pycache__/
!Linkpoint/tools/
!Linkpoint/tools/**
!Linkpoint/tools/protocol/
!Linkpoint/tools/protocol/**
!docker/
!docker/**
docker/**/*.env
!docker/grid-proxy/.env.example
!docker-compose.yml
!.env.example
build_output.txt

# Linkpoint Next JavaScript/Rust workspace output
/node_modules/
**/node_modules/
**/dist/
/.dart_tool/
**/.dart_tool/
/target/
/artifacts/
/coverage/
**/coverage/
*.lcov
lcov.info
/test-results/
/playwright-report/
**/test-results/
**/playwright-report/
