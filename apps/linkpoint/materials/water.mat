// Animated four-wave water surface at the region water level, reflecting the same atmosphere
// the sky dome shows. Port of WATER_VERTEX_SHADER / WATER_FRAGMENT_SHADER in src/linkpoint/sky.ts.
//
// Draw the createWaterPlane quad (z = 0 in the mesh) with an identity transform; the vertex stage
// moves it to uWaterHeight. Wave tables come from WATER_WAVES: uFrequency, uPhase and uAmplitude
// are the four entries packed in a float4, uDirection01 / uDirection23 hold the (x, y) pairs of
// waves 0,1 and 2,3. Camera position and time are material parameters, as in the old shader.
material {
    name : water,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    depthWrite : false,
    variables : [
        world
    ],
    parameters : [
        { type : float3, name : uBlueHorizon },
        { type : float3, name : uBlueDensity },
        { type : float3, name : uAmbient },
        { type : float3, name : uSunlight },
        { type : float3, name : uGlow },
        { type : float3, name : uLightNorm },
        { type : float,  name : uHazeHorizon },
        { type : float,  name : uHazeDensity },
        { type : float,  name : uDensityMultiplier },
        { type : float,  name : uMaxY },
        { type : float,  name : uCloudShadow },
        { type : float,  name : uSunUp },
        { type : float,  name : uSunMoonGlow },
        { type : float3, name : uCameraPos },
        { type : float3, name : uFogColor },
        { type : float,  name : uFogDensity },
        { type : float,  name : uFresnelScale },
        { type : float,  name : uFresnelOffset },
        { type : float3, name : uLightDir },
        { type : float3, name : uLightColor },
        { type : float3, name : uSurfaceAmbient },
        { type : float,  name : uTime },
        { type : float,  name : uPixelAngle },
        { type : float,  name : uNormalScale },
        { type : float,  name : uWaterHeight },
        { type : float4, name : uFrequency },
        { type : float4, name : uPhase },
        { type : float4, name : uAmplitude },
        { type : float4, name : uDirection01 },
        { type : float4, name : uDirection23 }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.worldPosition = vec4(getPosition().xy, materialParams.uWaterHeight, 1.0);
        material.world = vec4(material.worldPosition.xyz, 0.0);
    }
}

fragment {
//!include atmosphere.glsl

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 vWorld = variable_world.xyz;
        vec4 frequency = materialParams.uFrequency;
        vec4 phase = materialParams.uPhase;
        vec4 amplitude = materialParams.uAmplitude;
        vec2 direction[4];
        direction[0] = materialParams.uDirection01.xy;
        direction[1] = materialParams.uDirection01.zw;
        direction[2] = materialParams.uDirection23.xy;
        direction[3] = materialParams.uDirection23.zw;

        vec3 toCamera = materialParams.uCameraPos - vWorld;
        float distanceToCamera = length(toCamera);
        vec3 viewDir = toCamera / max(distanceToCamera, 0.0001);
        // Ground footprint of one pixel, stretched at grazing angles. A wave whose
        // wavelength is shorter than two footprints would alias into speckle, so
        // each wave fades out once it drops below that limit.
        float footprint = distanceToCamera * materialParams.uPixelAngle / max(viewDir.z, 0.1);
        vec2 slope = vec2(0.0);
        for (int i = 0; i < 4; i++) {
            float weight = clamp(1.0 - footprint * frequency[i] / 3.14159, 0.0, 1.0);
            float arg = dot(direction[i], vWorld.xy) * frequency[i] + materialParams.uTime * phase[i];
            slope += direction[i] * amplitude[i] * frequency[i] * cos(arg) * weight;
        }
        vec3 normal = normalize(vec3(-slope * materialParams.uNormalScale, 1.0));
        // Fresnel from the water settings: more reflective at grazing angles.
        float cosV = max(dot(normal, viewDir), 0.0);
        float f1 = clamp(materialParams.uFresnelOffset - materialParams.uFresnelScale * cosV, 0.0, 1.0);
        float reflectance = clamp(f1 * f1 * 4.0, 0.0, 1.0);
        // reflect the actual sky (the same atmosphere the dome shows)
        vec3 reflectDir = reflect(-viewDir, normal);
        reflectDir.z = abs(reflectDir.z);
        vec3 skyReflection = toneMapSky(atmosphereColor(reflectDir));
        // refracted colour: the water's fog tint, lit by what reaches the surface
        vec3 refracted = pow(clamp(materialParams.uFogColor
            * (materialParams.uSurfaceAmbient + materialParams.uLightColor * 0.6) * 1.6, 0.0, 1.0), vec3(1.0 / 2.2));
        // sun / moon glint
        float glint = pow(max(dot(reflect(-normalize(materialParams.uLightDir), normal), viewDir), 0.0), 220.0);
        vec3 color = mix(refracted, skyReflection, reflectance) + materialParams.uLightColor * glint * 3.0;
        // opacity from the fog density along the view path; reflections stay opaque
        float facing = max(viewDir.z, 0.12);
        float opacity = clamp(1.0 - exp(-materialParams.uFogDensity * 0.6 / facing), 0.45, 0.97);
        material.baseColor = vec4(color, max(opacity, reflectance));
    }
}
