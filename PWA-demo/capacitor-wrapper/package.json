{
  "name": "linkpoint-pwa-capacitor",
  "version": "1.0.0",
  "description": "Linkpoint PWA Mobile App",
  "scripts": {
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "android:sync": "cap sync android",
    "ios:sync": "cap sync ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "android:run": "cap run android",
    "ios:run": "cap run ios",
    "android:build": "cap sync android && cd android && ./gradlew assembleRelease",
    "ios:build": "cap sync ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release",
    "sync": "cap sync",
    "copy": "cap copy"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/ios": "^5.0.0",
    "@capacitor/splash-screen": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
